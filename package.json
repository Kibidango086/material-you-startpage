{
  "name": "my-startpage-extension",
  "description": "My Startpage — 新标签页替换为 mystartup.kibidango.top",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
